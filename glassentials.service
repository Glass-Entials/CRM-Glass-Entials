# ─────────────────────────────────────────────────────────────────────────────
# glassentials.service — EXAMPLE / TEMPLATE systemd service file only
#
# IMPORTANT DEPLOYMENT NOTICE:
# - This tracked repository file is an illustrative template only.
# - It is NOT the active production service file.
# - The authoritative active production service on Hostinger VPS is `crm.service`,
#   running from `/var/www/CRM-Glass-Entials`.
# - Do NOT overwrite, replace, or rename `crm.service` with this file.
# - The paths below (e.g. /home/ubuntu/glassentials) are example template placeholders.
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=GlassEntials CRM — Gunicorn WSGI Server (Example Template)
Documentation=https://github.com/your-repo/glassentials
After=network.target network-online.target
Wants=network-online.target

[Service]
# Example user/group (adjust to target host configuration)
User=ubuntu
Group=www-data
# Example working directory placeholder (authoritative production is /var/www/CRM-Glass-Entials)
WorkingDirectory=/home/ubuntu/glassentials

# Example environment file placeholder
EnvironmentFile=/home/ubuntu/glassentials/.env

# Activate virtualenv and run Gunicorn (example template path)
ExecStart=/home/ubuntu/glassentials/venv/bin/gunicorn \
    --config /home/ubuntu/glassentials/gunicorn.conf.py \
    wsgi:application

# Graceful reload (SIGHUP)
ExecReload=/bin/kill -s HUP $MAINPID

# Auto-restart on failure
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Prevent privilege escalation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/glassentials/static/uploads /home/ubuntu/glassentials/migrations

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging (stdout/stderr → journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=glassentials

# Kill mode
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target