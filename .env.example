# Flask configuration
SECRET_KEY=your_super_secret_production_key_here
FLASK_ENV=production

# Database configuration (Replace with your actual production DB details)
# E.g., for AWS RDS, DigitalOcean Managed DB, or Railway:
DATABASE_URL=mysql+pymysql://username:password@host:port/database_name

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft Entra ID (Azure AD) OAuth 2.0
# Register your app at https://portal.azure.com → Azure Active Directory → App Registrations
# Add Redirect URI: https://yourdomain.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_value_here

# ---------------------------------------------------------------------------
# Super Admin Portal (Phase 1)
# ---------------------------------------------------------------------------
# Username used to log into admin.glassentials.in
SUPER_ADMIN_USERNAME=superadmin

# Werkzeug-hashed password — NEVER use a plain-text password here.
# Generate: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourPassword'))"
SUPER_ADMIN_PASSWORD_HASH=pbkdf2:sha256:...your_generated_hash_here...

# Email address that receives the 6-digit OTP on every super admin login
SUPER_ADMIN_EMAIL=admin@glassentials.in
