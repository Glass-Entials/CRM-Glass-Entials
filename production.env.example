# ─────────────────────────────────────────────────────────────────────────────
# production.env.example
# Hostinger VPS Production Environment Configuration (.env)
#
# IMPORTANT DEPLOYMENT SAFETY INSTRUCTIONS:
# 1. DO NOT blindly copy or overwrite an existing production .env file!
#    Doing so will destroy existing database passwords, secret keys, and tokens.
# 2. Before making any changes on the Hostinger VPS, always create a timestamped backup:
#    cp /var/www/CRM-Glass-Entials/.env /var/www/CRM-Glass-Entials/.env.backup.$(date +%F_%T)
# 3. For new or updated configurations, selectively MERGE the keys below into your
#    existing .env file (especially the SaaS Billing & Payments block).
# 4. Fill in all placeholder values (REPLACE_WITH_*) with actual live credentials.
# 5. Ensure file permissions remain strictly restricted:
#    chmod 600 /var/www/CRM-Glass-Entials/.env
# 6. NEVER commit actual .env values to git.
# 7. Hostinger uses direct .env file loading via python-dotenv.
#    Keep USE_AWS_SECRETS=false. Do NOT use AWS Secrets Manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask core ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# Production mode MUST be explicitly set to 'production' (Flask 3 does not default to it)
FLASK_ENV=production

# ── Database (Hostinger MySQL 8) ──────────────────────────────────────────────
# Example Hostinger local MySQL database URL (adjust host/port/database/credentials to your server):
DATABASE_URL=mysql+pymysql://crm_user:STRONG_PASSWORD@localhost:3306/crm_production

# ── Session & Cookie hardening ────────────────────────────────────────────────
# Enforce HTTPS cookies behind Nginx reverse proxy / SSL
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Session lifetime in seconds (8 hours)
PERMANENT_SESSION_LIFETIME=28800

# ── File uploads ──────────────────────────────────────────────────────────────
# Max upload size in bytes (default 5MB)
MAX_CONTENT_LENGTH=5242880
# Example path on Hostinger VPS (verify actual directory on server, e.g. /var/www/CRM-Glass-Entials/static/uploads):
UPLOAD_FOLDER=/var/www/CRM-Glass-Entials/static/uploads

# ── GST API Integration ───────────────────────────────────────────────────────
GST_CLIENT_ID=REPLACE_WITH_NEW_CLIENT_ID
GST_CLIENT_SECRET=REPLACE_WITH_NEW_CLIENT_SECRET

# ── Hostinger Infrastructure Settings (No AWS) ────────────────────────────────
# Keep USE_AWS_SECRETS=false for Hostinger deployment.
# Secrets and configs are loaded directly from this .env file.
USE_AWS_SECRETS=false

# Leave S3_BUCKET_NAME blank on Hostinger to use local filesystem (UPLOAD_FOLDER)
S3_BUCKET_NAME=
S3_UPLOAD_PREFIX=

# ── Redis (optional local Redis on Hostinger VPS) ─────────────────────────────
# Local: redis://localhost:6379/0 (if Redis installed, otherwise leave default)
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── SaaS Billing & Payments (PhonePe AutoPay V2) ──────────────────────────────
# PhonePe AutoPay V2 is the ONLY active payment provider for subscriptions.
# NOTE: Razorpay is currently INACTIVE and reserved for potential future integration.
# Do NOT configure Razorpay keys in production.
BILLING_DEFAULT_PROVIDER=phonepe_v2

# PhonePe Gateway Environment: PRODUCTION (live) or UAT (staging/sandbox only)
# Production deployment MUST use PRODUCTION.
PHONEPE_ENV=PRODUCTION

# PhonePe Merchant ID (OPTIONAL for PhonePe AutoPay V2 direct merchants)
# PhonePe AutoPay V2 uses OAuth 2.0 Client Credentials (PHONEPE_CLIENT_ID, PHONEPE_CLIENT_SECRET, PHONEPE_CLIENT_VERSION).
# Direct merchants onboarded via PhonePe Business Dashboard do NOT have a static Merchant ID and can leave this blank.
# Only set this if operating as a partner/aggregator transacting on behalf of sub-merchants (X-MERCHANT-ID header)
# or when legacy PhonePe V3 compatibility is explicitly authorized.
# Cannot be PGTESTPAYUAT in production if populated.
PHONEPE_MERCHANT_ID=

# PhonePe AutoPay V2 OAuth Credentials (from PhonePe Business Dashboard)
PHONEPE_CLIENT_ID=REPLACE_WITH_PRODUCTION_CLIENT_ID
PHONEPE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_CLIENT_SECRET
# Client Version: must be a positive integer (e.g. 1)
PHONEPE_CLIENT_VERSION=1

# PhonePe S2S Webhook Basic Auth Credentials
# Configured in PhonePe Merchant Dashboard -> Webhooks
PHONEPE_WEBHOOK_USERNAME=REPLACE_WITH_WEBHOOK_USERNAME
PHONEPE_WEBHOOK_PASSWORD=REPLACE_WITH_WEBHOOK_STRONG_PASSWORD

# Dedicated secret for automated renewal cron endpoint (/saas/api/process-renewals)
# Must be a dedicated 64-char hex string, distinct from SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RENEWAL_CRON_SECRET=REPLACE_WITH_DEDICATED_RENEWAL_CRON_SECRET

# PhonePe Legacy V3 Webhook Security Flags (fails closed: default false in production)
# Set ENABLE_PHONEPE_V3_WEBHOOK=false in production unless legacy V3 subscriptions exist.
# If ENABLE_PHONEPE_V3_WEBHOOK=true is set in production, startup validation will fail closed
# unless ALLOW_LEGACY_PHONEPE_V3=true is also explicitly configured as a deliberate authorization.
ENABLE_PHONEPE_V3_WEBHOOK=false
ALLOW_LEGACY_PHONEPE_V3=false